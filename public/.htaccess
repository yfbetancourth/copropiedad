Options -Indexes
# La raíz del proyecto (y la de cada copia en conjuntos/) niega el acceso web; solo public/ se publica.
Require all granted
RewriteEngine On
# Each application scenario has its own front controller.
RewriteRule ^admin/index\.php$ - [L]
RewriteRule ^usuario/index\.php$ - [L]
RewriteRule ^admin(?:/.*)?$ admin/index.php [QSA,L]
RewriteRule ^usuario(?:/.*)?$ usuario/index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
