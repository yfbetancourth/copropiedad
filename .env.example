APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/Copropiedad/public

# Multicliente: cada conjunto residencial se abre en {slug}.APP_BASE_DOMAIN y la consola del
# Superadmin en APP_BASE_DOMAIN. En local, localtest.me resuelve cualquier subdominio a 127.0.0.1
# (p. ej. http://principal.localtest.me/Copropiedad/public). En producción usa tu dominio y un
# DNS comodín (*.tudominio.com) con certificado SSL comodín.
APP_BASE_DOMAIN=localtest.me
# Solo fuera de producción: conjunto que se abre con un host que no es del dominio base (p. ej. localhost).
APP_DEFAULT_TENANT=principal
# Nombre de la plataforma en la consola del Superadmin.
APP_NAME=Copropiedad

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=copropiedad
DB_USERNAME=copropiedad_app
DB_PASSWORD=
DB_SSL_CA=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Copropiedad

# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Zona horaria de la aplicación (por defecto America/Bogota)
APP_TIMEZONE=America/Bogota
