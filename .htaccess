# Solo public/ (y conjuntos/{slug}/public/) es accesible por web. Esto protege .env, app/, storage/,
# vendor/ y database/ cuando el servidor publica toda la carpeta del proyecto (p. ej. XAMPP en htdocs).
# En producción, el dominio debe apuntar directamente a la carpeta public/ correspondiente.
#
# Excepción: la raíz del proyecto y /admin o /usuario se permiten solo para redirigir a public/ (comodidad en
# local: http://localhost/Copropiedad/ abre la aplicación). Cualquier otro archivo o carpeta de la raíz sigue negado.
<RequireAny>
    Require expr "%{REQUEST_URI} =~ m#^/[^/]+(/((admin|usuario)/?)?)?$#i"
</RequireAny>

RewriteEngine On
# El destino se arma con la ruta de la URL (no relativa): en Windows una sustitución relativa con R incluiría la ruta
# física del disco.
RewriteCond %{REQUEST_URI} ^(/[^/]+)/$
RewriteRule ^$ %1/public/ [R=302,L]
RewriteCond %{REQUEST_URI} ^(/[^/]+)/(admin|usuario)/?$ [NC]
RewriteRule ^ %1/public/%2/ [R=302,L]
