{
    "name": "copropiedad/app",
    "description": "Aplicacion modular de administracion de copropiedad",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
